{
  "permissions": {
    "allow": [
      "PowerShell(dotnet ef *)",
      "PowerShell(docker --version; docker ps 2>&1 | Select-Object -First 3)",
      "PowerShell(\\(Get-Command npm\\).Source)",
      "Bash(npm run *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)",
      "Bash(pkill -f \"NakliyeApp.API\")",
      "Bash(dotnet run *)",
      "Bash(curl -s -o /dev/null -w \"API: %{http_code}\" http://localhost:5000/swagger/index.html)",
      "PowerShell(Get-Process *)",
      "Bash(curl -s -o /dev/null -w \"API: %{http_code}\\\\n\" http://localhost:5000/swagger/index.html)",
      "Bash(curl -s -X POST http://localhost:5000/api/auth/login -H 'Content-Type: application/json' -d '{\"email\":\"test@nakliye.com\",\"password\":\"Test@123\"}')",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/)",
      "Bash(echo \"Frontend: $\\(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/\\)\")",
      "Bash(git init *)",
      "Bash(git config *)",
      "Bash(git add *)"
    ]
  }
}
